# Copy to backend/.env (git-ignored) and fill in. Never commit real keys.

# --- LLM provider: "anthropic" (Claude) or "gemini". Leave empty to use whichever key is set.
# Without any key the app still runs, using a clearly labelled template fallback.
LLM_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (low keeps reminder drafting fast and cheap)
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
PROMPT_VERSION=v2

# --- App
APP_ENV=development
# Long random string; required in production so sessions survive restarts.
SECRET_KEY=
# DATABASE_PATH=db/onboarding.db
MAX_UPLOAD_MB=5

# --- Public demo protection (Render). Leave empty locally.
DEMO_ACCESS_CODE=
AI_RATE_LIMIT_PER_MINUTE=20
